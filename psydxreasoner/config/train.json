{
  "base_model": "${MODEL_ROOT}/Qwen2.5-Omni-7B",
  "data_root": "${DATA_ROOT}/psydxreasoner",
  "source_data_root": "${DATA_ROOT}",
  "output_dir": "${OUTPUT_ROOT}/psydxreasoner/checkpoints",
  "run_dir": "${OUTPUT_ROOT}/psydxreasoner/run",
  "generator_adapter": "${LORA_ROOT}/omniprofiler",
  "generator_data_root": "${DATA_ROOT}/omniprofiler",
  "reconstruction_code_root": "${CODE_ROOT}",
  "seed": 42,
  "num_generations": 6,
  "num_train_epochs": 3,
  "learning_rate": 5e-06,
  "lora_rank": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.0,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 24,
  "steps_per_generation": 3,
  "max_completion_length": 256,
  "context_limit": 32768,
  "temperature": 1.0,
  "beta": 0.04,
  "warmup_ratio": 0.05,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "logging_steps": 1,
  "save_steps": 25,
  "eval_steps": 25,
  "save_total_limit": 5,
  "validation_batch_size": 2,
  "projection_chunk_size": 64,
  "cpu_offload_embedding": false,
  "reward_weights": {
    "format": 0.5,
    "label": 1.0,
    "rationale": 0.5
  },
  "judge": {
    "model": "qwen3.8-flash",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "system_prompt": "${CODE_ROOT}/psydxreasoner/prompts/rationale_judge_system.txt",
    "key_env": "DASHSCOPE_API_KEY",
    "cache_path": "${OUTPUT_ROOT}/psydxreasoner/judge_cache.sqlite",
    "workers": 6,
    "timeout_seconds": 90,
    "max_attempts": 4
  },
  "evaluation": {
    "output_dir": "${OUTPUT_ROOT}/psydxreasoner/evaluation",
    "max_new_tokens": 256,
    "generator_max_new_tokens": 1536,
    "seed": 42
  },
  "recovery_save_steps": 5,
  "adapter": "${LORA_ROOT}/psydxreasoner"
}
