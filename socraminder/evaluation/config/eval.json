{
  "source_project": "${CODE_ROOT}/socraminder",
  "python": "python3",
  "cbt_python": "python3",
  "base_model": "${MODEL_ROOT}/Qwen2.5-Omni-7B",
  "adapter": "${LORA_ROOT}/socraminder",
  "cbt_model": "${MODEL_ROOT}/CBT-LLM",
  "cases": "${DATA_ROOT}/socraminder/evaluation_cases.jsonl",
  "simulator_model": "qwen3.8-flash",
  "baseline_api_model": "qwen3.7-flash",
  "judge_model": "qwen-plus",
  "api": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
