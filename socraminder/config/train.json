{
  "base_model": "${MODEL_ROOT}/Qwen2.5-Omni-7B",
  "data_root": "${DATA_ROOT}/socraminder/sft",
  "output_dir": "${OUTPUT_ROOT}/socraminder/checkpoints",
  "run_dir": "${OUTPUT_ROOT}/socraminder/training",
  "seed": 42,
  "lora_rank": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "learning_rate": 0.0001,
  "num_train_epochs": 3,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "warmup_ratio": 0.03,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "logging_steps": 1,
  "save_total_limit": 5,
  "context_limit": 16384,
  "projection_chunk_size": 128,
  "optim": "adamw_torch_fused",
  "cpu_offload_embedding": false,
  "startup_smoke_test": true,
  "eval_strategy": "steps",
  "save_strategy": "steps",
  "group_by_length": true,
  "expected_train_patients": 163,
  "expected_dev_patients": 56,
  "require_patient_ids": true,
  "eval_steps": 100,
  "save_steps": 100,
  "adapter": "${LORA_ROOT}/socraminder"
}
