{
  "base_model": "${MODEL_ROOT}/Qwen2.5-Omni-7B",
  "data_root": "${DATA_ROOT}/omniprofiler",
  "output_dir": "${OUTPUT_ROOT}/omniprofiler/checkpoints",
  "run_dir": "${OUTPUT_ROOT}/omniprofiler/run",
  "seed": 42,
  "lora_rank": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "learning_rate": 0.0001,
  "num_train_epochs": 3,
  "per_device_train_batch_size": 4,
  "gradient_accumulation_steps": 2,
  "warmup_ratio": 0.03,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "logging_steps": 5,
  "eval_steps": 100,
  "save_steps": 100,
  "save_total_limit": 5,
  "torch_empty_cache_steps": null,
  "context_limit": 32768,
  "startup_smoke_test": true,
  "cpu_offload_embedding": false,
  "per_device_eval_batch_size": 4,
  "group_by_length": true,
  "projection_chunk_size": 512,
  "optim": "adamw_torch_fused",
  "adapter": "${LORA_ROOT}/omniprofiler"
}
