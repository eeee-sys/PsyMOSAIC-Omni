{
  "experiment_name": "pharmawiser",
  "base_model": "${MODEL_ROOT}/Qwen2.5-Omni-7B",
  "test_file": "${DATA_ROOT}/pharmawiser/test_original.jsonl",
  "output_dir": "${OUTPUT_ROOT}/pharmawiser/evaluation",
  "student_system_prompt": "prompts/student_system.txt",
  "judge_system_prompt": "prompts/judge_system.txt",
  "context_limit": 16384,
  "seed": 42,
  "models": {
    "pharmawiser": {
      "label": "SFT + adaptive difficulty-group GRPO",
      "adapter_path": "${LORA_ROOT}/pharmawiser"
    }
  },
  "generation": {
    "max_new_tokens": 1024,
    "do_sample": false,
    "num_beams": 1,
    "repetition_penalty": 1.0,
    "no_repeat_ngram_size": 0
  },
  "judge": {
    "model": "qwen3.8-flash",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "key_env": "DASHSCOPE_API_KEY",
    "temperature": 0.0,
    "max_tokens": 1536,
    "timeout_seconds": 120,
    "max_attempts_per_run": 5,
    "retry_delay_seconds": 2.0,
    "include_original_reference_advisory": true
  },
